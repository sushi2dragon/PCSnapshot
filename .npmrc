# Keep npm itself off the network for anything but an explicit install.
# `npm test` / `npm run <script>` otherwise still ping the registry via the
# update notifier, and installs fire audit + funding lookups.
audit=false
fund=false
update-notifier=false

# Uncomment to forbid registry access on install as well (fails instead of
# fetching when a package is missing from the local cache):
# offline=true
